\newcommand{\labprotocol}[7] {
  \begin{center}
    {\fontsize{14pt}{17pt}\selectfont
      \bfseries\large
      \setlength{\baselineskip}{17pt}
      \strut{ПРОТОКОЛ НАБЛЮДЕНИЙ} \linebreak
      \strut{ЛАБОРАТОРНАЯ РАБОТА №#1} \linebreak
      \strut{#2}
    }
  \end{center}

  #3

  \begin{flushright}
    \underline{Экспериментальный макет}
  \end{flushright}

  #4

  \vfill
  \begin{tabular}{ll}
    Выполнил:&~~~\underline{#5} \\ \\
    &Факультет #6 \\ \\
    &Группа № #7
  \end{tabular}

  \vspace{1cm}

  \begin{tabular}{l}
    <<\_\_>> \_\_\_\_\_\_ \_\_\_\_ \\ \\
    Преподаватель: \_\_\_\_\_\_\_\_\_\_\_\_ \\ \\
  \end{tabular}
  \newpage
}


\newcommand{\labsection}[2] {
  \section*{#2 #1}
}

\pgfkeys{
  /labpreparation/.is family,
  /labpreparation/number/.store in=\labpreparationNumber,
  /labpreparation/labname/.store in=\labpreparationLabname,
  /labpreparation/myname/.store in=\labpreparationMyname,
  /labpreparation/group/.store in=\labpreparationGroup,
  /labpreparation/professor/.store in=\labpreparationProfessor,
  /labpreparation/year/.store in=\labpreparationYear,
  /labpreparation/faculty/.store in=\labpreparationFaculty,
  /labpreparation/show/.store in=\labpreparationShow%
}

\newcommand{\labpreparation}[7] {
  \ifx#71
    \pgfkeys{/labpreparation, #1}
    \mytitlepage{\labpreparationNumber}{\labpreparationLabname}{\labpreparationMyname}{\labpreparationGroup}{\labpreparationProfessor}{\labpreparationYear}
    \newpage
    \begin{center}
      \bfseries\large ЛАБОРАТОРНАЯ РАБОТА №\labpreparationNumber\linebreak
      \labpreparationLabname%
    \end{center}

    \labsection{ЦЕЛЬ РАБОТЫ}{\large}
    #2

    \labsection{СХЕМА УСТАНОВКИ И ИСПОЛЬЗУЕМЫЕ ПРИБОРЫ}{\large}
    #3

    \labsection{ОСНОВНЫЕ ЗАКОНОМЕРНОСТИ}{\large}
    #4
    \newpage
    \labprotocol{\labpreparationNumber}{\labpreparationLabname}{#5}{#6}{\labpreparationMyname}{\labpreparationFaculty}{\labpreparationGroup}
  \fi
}
